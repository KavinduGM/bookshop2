# Copy to .env for local runs; on Dokploy put these in the Environment tab.

# Password for the database container. Any long random string.
DB_PASSWORD=change-me-to-something-long

# Signs the session cookies. Generate once and keep it —
# changing it signs every device out.
#   openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# The one password the shop staff share.
STAFF_PASSWORD=change-me

# The admin's password, and username if you want something other than "Admin".
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=Admin
